    <script>
    /* SH2SC-EDT — pre-Pagedjs marking: find every <p> that immediately follows a
       <formula data-block=""> in the source DOM and add class "after-display-math".
       This must run in Paged.Handler.afterParsed(), which fires BEFORE Pagedjs splits
       content into pages — ensuring the class survives pagination regardless of whether
       a page break falls between the formula and the paragraph. */
    (function() {
      function tryRegister() {
        if (typeof Paged === 'undefined') { setTimeout(tryRegister, 50); return; }
        class AfterDisplayMathMarker extends Paged.Handler {
          afterParsed(parsed) {
            var formulas = parsed.querySelectorAll('formula[data-block]');
            formulas.forEach(function(formula) {
              var next = formula.nextElementSibling;
              if (next && next.tagName === 'P') {
                next.classList.add('after-display-math');
              }
            });

          }
        }
        Paged.registerHandlers(AfterDisplayMathMarker);

        /* Title page (first page): hide running header and footer text.
           Pagedjs does not reliably honour @page :first { @top-right { content: none } }
           for custom margin boxes, so the margin-content nodes are hidden via
           DOM manipulation after rendering. Separator lines are preserved. */
        class TitlePageNoHeaders extends Paged.Handler {
          afterRendered() {
            var firstPage = document.querySelector('.pagedjs_first_page');
            if (firstPage) {
              firstPage.querySelectorAll('.pagedjs_margin-content').forEach(function(box) {
                box.style.visibility = 'hidden';
              });
            }
          }
        }
        Paged.registerHandlers(TitlePageNoHeaders);
      }
      tryRegister();
    })();
    </script>


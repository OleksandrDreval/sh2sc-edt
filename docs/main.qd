.docname {SH2SC-EDT and C2P-ARQ: A Self-Healing Hardware and Software Complex Utilizing the ChaCha20-Poly1305 Automatic Repeat reQuest Protocol}
.docdescription {A paper about SH2SC-EDT and the C2P-ARQ protocol for fault-tolerant encrypted data transmission on ATmega328P hardware.}
.docauthors
    - Oleksandr Dreval
        - email: drevaloleksandr@gmail.com
.dockeywords
  - SH2SC-EDT
  - C2P-ARQ
  - ChaCha20-Poly1305
  - authenticated encryption
  - automatic repeat request
  - ATmega328P
  - SimulIDE
  - fault tolerance
.doctype {paged}
.doclang {en}

.theme {paperwhite}
.numbering
    - headings: 1.1.1
    - figures: 1.1
    - tables: 1.1
    - equations: (1)
    - code: 1
    - footnotes: 1

.paragraphstyle letterspacing:{0} spacing:{0} indent:{1.5}
.pageformat bordertop:{0.5pt} borderbottom:{0.5pt} bordercolor:{#333333}


    /* IACR / Springer LNCS paragraph formatting */
    .quarkdown.quarkdown-paged p {
      text-align: justify !important;
      margin-top: 0 !important;
      orphans: 3;
      widows: 3;
    }

    /* First paragraph directly after any heading: no indent */
    .quarkdown.quarkdown-paged h1 + p,
    .quarkdown.quarkdown-paged h2 + p,
    .quarkdown.quarkdown-paged h3 + p,
    .quarkdown.quarkdown-paged h4 + p,
    .quarkdown.quarkdown-paged h5 + p,
    .quarkdown.quarkdown-paged h6 + p {
      text-indent: 0 !important;
    }

    /* First paragraph after lists, code blocks, tables: no indent.
       NOTE: figures, diagrams (.mermaid), and captions (.center, .container)
       are intentionally excluded — the paragraph after a floating object is
       a new logical paragraph and therefore receives first-line indent. */
    .quarkdown.quarkdown-paged ul + p,
    .quarkdown.quarkdown-paged ol + p,
    .quarkdown.quarkdown-paged pre + p,
    .quarkdown.quarkdown-paged blockquote + p,
    .quarkdown.quarkdown-paged table + p {
      text-indent: 0 !important;
    }

    /* No indent after display math — the "where x is..." line is a syntactic
       continuation of the sentence that introduced the formula.
       Quarkdown renders block math as <formula data-block="">, NOT as .katex-display.
       The adjacent sibling selector covers the same-page case; the .after-display-math
       class (set by AfterDisplayMathMarker before Pagedjs paginates) covers the
       cross-page case where a page break falls between formula and paragraph. */
    .quarkdown.quarkdown-paged formula[data-block] + p,
    .quarkdown.quarkdown-paged .after-display-math {
      text-indent: 0 !important;
    }

    /* Prevent text-indent and text-align:justify from leaking into Mermaid diagram
       internal labels. Mermaid may render node text via <p> inside <foreignObject>. */
    .quarkdown.quarkdown-paged .mermaid p {
      text-indent: 0 !important;
      text-align: center !important;
      margin: 0 !important;
    }

    /* Display math blocks must not receive text-align:justify — they are
       centred by default and justification corrupts KaTeX layout. */
    .quarkdown.quarkdown-paged formula[data-block] {
      text-align: center !important;
    }

    /* No indent inside centered captions, math display, ToC */
    .quarkdown.quarkdown-paged .center p,
    .quarkdown.quarkdown-paged .katex-display p,
    .quarkdown.quarkdown-paged .table-of-contents p {
      text-indent: 0 !important;
      text-align: center !important;
    }

    /* Image/diagram captions in .container — no indentation, centered */
    .quarkdown.quarkdown-paged .container p {
      text-indent: 0 !important;
      text-align: center !important;
    }

    /* Paragraph after a caption (.container) is a new logical paragraph;
       it receives the standard first-line indent — no override needed here. */

    /* Continuation of paragraph on next page (Pagedjs data-split-from): no indentation.
       Specificity (0,3,1) intentionally exceeds .quarkdown.quarkdown-paged p (0,2,1)
       so this !important wins when both apply to the same split element. */
    .quarkdown.quarkdown-paged p[data-split-from] {
      text-indent: 0 !important;
    }

    /* Last visible line of a paragraph that continues on the next page (data-split-to)
       must also be justified — otherwise it renders left-aligned like a paragraph ending. */
    .quarkdown.quarkdown-paged p[data-split-to] {
      text-align-last: justify !important;
    }

    /* Preserve math display block spacing */
    .katex-display {
      margin: 0.6em 0;
    }

    /* Mirrored headers & footers (C2P-ARQ paper)

       topinside:     right pages → top-left  (page number)
                      left  pages → top-right (page number)
       topoutside:    right pages → top-right (O. Dreval: SH2SC-EDT)
                      left  pages → top-left  (O. Dreval: SH2SC-EDT)
       bottominside:  right pages → bottom-left  (O. Dreval: C2P-ARQ)
                      left  pages → bottom-right (O. Dreval: C2P-ARQ)
       bottomoutside: right pages → bottom-right (page number)
                      left  pages → bottom-left  (page number)

       Left margin boxes are flush-left; right margin boxes are flush-right,
       pushing page number and title to their respective outer edges.
       Separator lines sit on the bottom edge of .pagedjs_margin-top and the
       top edge of .pagedjs_margin-bottom — the exact header/footer boundary. */

    /* Left margin boxes: flush to the left edge */
    .pagedjs_page .pagedjs_margin-top-left .pagedjs_margin-content,
    .pagedjs_page .pagedjs_margin-bottom-left .pagedjs_margin-content {
      font-size: 9pt;
      line-height: 1.2;
      text-align: left;
      width: 100%;
      padding: 0 !important;
      box-sizing: border-box;
    }

    /* Right margin boxes: flush to the right edge */
    .pagedjs_page .pagedjs_margin-top-right .pagedjs_margin-content,
    .pagedjs_page .pagedjs_margin-bottom-right .pagedjs_margin-content {
      font-size: 9pt;
      line-height: 1.2;
      text-align: right;
      width: 100%;
      padding: 0 !important;
      box-sizing: border-box;
    }

    /* Suppress paragraph indent/justify rules that leak into margin boxes */
    .pagedjs_page .pagedjs_margin-content p {
      text-indent: 0 !important;
      text-align: inherit !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    /* Header boxes: push content to bottom so text sits adjacent to separator line */
    .pagedjs_page .pagedjs_margin-top-left,
    .pagedjs_page .pagedjs_margin-top-right {
      display: flex;
      align-items: flex-end;
      padding: 0;
    }

    /* Footer boxes: push content to top so text sits adjacent to separator line */
    .pagedjs_page .pagedjs_margin-bottom-left,
    .pagedjs_page .pagedjs_margin-bottom-right {
      display: flex;
      align-items: flex-start;
      padding: 0;
    }

    /* Space between separator lines and the running text.
       padding-top pushes text away from the header rule;
       padding-bottom pushes text away from the footer rule. */
    .pagedjs_area {
      padding-top: 14pt !important;
      padding-bottom: 14pt !important;
    }

     /* Title page (page 1): TitlePageNoHeaders JS sets visibility:hidden on every
       .pagedjs_margin-content node, hiding the running text while preserving the
       native page borders and the surrounding page geometry. */

    /* .page-start forces a hard page break via the Pagedjs CSSOM scanner.
       Applied in afterParsed (JS) to the Abstract <p>, and also placed as an
       explicit <div class="page-start"> in the source directly before Abstract.
       Using a stylesheet class (not an inline style attribute) ensures Pagedjs
       detects the break declaration during its pre-chunking CSSOM scan. */
    .page-start {
      break-before: page !important;
      page-break-before: always !important;
    }

    /* Page-break avoidance: prevent hanging headings
       Forbid a page break immediately AFTER any heading level so that
       Pagedjs pushes the heading to the next page when its first body
       paragraph does not fit on the same page. Both the modern W3C
       property (break-after) and the legacy alias (page-break-after)
       are set for maximum compatibility with Pagedjs / Chromium. */
    .quarkdown.quarkdown-paged h1,
    .quarkdown.quarkdown-paged h2,
    .quarkdown.quarkdown-paged h3,
    .quarkdown.quarkdown-paged h4,
    .quarkdown.quarkdown-paged h5,
    .quarkdown.quarkdown-paged h6 {
      break-after: avoid !important;
      page-break-after: avoid !important;
    }

    /* REFINED GLOBAL TEXT RETENTION SAFEGUARD
       Prevents text swallowing, but safely EXCLUDES visual
       blocks (mermaid, katex, containers) so they don't bloat. */
    .quarkdown.quarkdown-paged p,
    .quarkdown.quarkdown-paged ul,
    .quarkdown.quarkdown-paged ol,
    .quarkdown.quarkdown-paged li,
    .quarkdown.quarkdown-paged blockquote,
